# Production settings for the Azure VM. Copy to .env on the server and fill
# in every <...>. No real secret belongs in this file: it is in git.
# Walkthrough: docs/DEPLOYMENT.md.

# Make one on the server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<generate on the server>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.floodscout.me
DJANGO_CSRF_TRUSTED_ORIGINS=https://floodscout.me,https://api.floodscout.me
DJANGO_SECURE_COOKIES=True
# Keep False: Cloudflare already redirects to HTTPS; a second redirect loops.
DJANGO_SSL_REDIRECT=False
# Raise to 31536000 once everything has worked for a week.
DJANGO_HSTS_SECONDS=3600
# Caddy is the one proxy that sets X-Forwarded-For (to the visitor's address).
DJANGO_NUM_PROXIES=1
# Where the Django admin lives. Pick a path nobody would guess, and keep it
# out of chat and git, like a password.
DJANGO_ADMIN_PATH=<pick a hard-to-guess path>/

DB_NAME=floodscout
DB_USER=floodscout_admin
DB_PASSWORD=<the database password set in the Azure portal>
DB_HOST=floodscout-db.postgres.database.azure.com
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://floodscout.me,https://api.floodscout.me
PUBLIC_API_URL=https://api.floodscout.me/api
DASHBOARD_URL=https://floodscout.me

# Email, from the dedicated Gmail sender with an app password. Leave
# EMAIL_HOST empty to write emails to data/outbox/ instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<sender>@gmail.com
EMAIL_HOST_PASSWORD=<gmail app password>
DEFAULT_FROM_EMAIL=FloodScout <<sender>@gmail.com>

# Africa's Talking. "sandbox" sends to the simulator, not to phones.
AT_USERNAME=sandbox
AT_API_KEY=

# Sign in with Google. Register this redirect URI in the Google Cloud console:
#   https://api.floodscout.me/api/auth/social/google/callback/
GOOGLE_CLIENT_ID=<from the Google Cloud console>
GOOGLE_CLIENT_SECRET=<from the Google Cloud console>
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The alerts say they are an exercise, not official warnings.
CAP_STATUS=Exercise

# ReliefWeb flood reports for the model's live record. Empty until ReliefWeb
# approves an app name (https://apidoc.reliefweb.int/parameters#appname).
RELIEFWEB_APPNAME=

# Read by Compose for Caddy (docker-compose.prod.yml), not by Django.
API_HOST=api.floodscout.me
