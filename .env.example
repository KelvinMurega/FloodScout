DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used when running Django in Docker Compose (service name "db").
# Switch to DB_HOST=localhost if running manage.py directly on your host
# against the same Postgres container (with its port published, as below).
DB_NAME=floodscout
DB_USER=floodscout
DB_PASSWORD=floodscout
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# From your Google Earth Engine registration — see AI_USE_LOG.md
EE_PROJECT_ID=floodscout-166914

# Host port the API is published on. Change it if something else
# already owns 8000; the container still listens on 8000 inside.
# Must match VITE_API_BASE_URL in frontend/.env.local.
WEB_PORT=8000
