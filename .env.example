DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Where the Django admin lives; pick something not guessable in production.
DJANGO_ADMIN_PATH=admin/

# Used when running Django in Docker Compose (service name "db").
# Switch to DB_HOST=localhost if running manage.py directly on your host
# against the same Postgres container (with its port published, as below).
DB_NAME=floodscout
DB_USER=floodscout
DB_PASSWORD=floodscout
DB_HOST=db
DB_PORT=5432
# Port the database is published on, on this computer only (127.0.0.1).
# Change it if a Postgres installed on the computer already uses 5432; then
# use DB_PORT=<this> too when running manage.py on the host.
DB_HOST_PORT=5432

# Proxies in front of the API: 0 when reached directly, 1 behind one reverse
# proxy that sets X-Forwarded-For. Rate limits trust that header only then.
DJANGO_NUM_PROXIES=0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: your Google Earth Engine project, used only by
# `build_training_set --rain-source earth-engine`.
EE_PROJECT_ID=floodscout-166914

# Host port the API is published on. Change it if something else
# already owns 8000; the container still listens on 8000 inside.
# Must match VITE_API_BASE_URL in frontend/.env.local.
WEB_PORT=8000

# Alerts. Without EMAIL_HOST, emails are written to data/outbox/ instead of
# sent. With a Gmail account, use an app password:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=FloodScout <you@gmail.com>

# Africa's Talking SMS, only for confirming a profile's phone (alerts go by
# email). Username "sandbox" sends to the dashboard simulator.
AT_USERNAME=sandbox
AT_API_KEY=

# Where links in alert messages point. Match WEB_PORT.
PUBLIC_API_URL=http://localhost:8000/api
DASHBOARD_URL=http://localhost:5173

# Sign in with Google, Microsoft or GitHub. Leave blank to hide a provider.
# The redirect URI to register with each (it follows PUBLIC_API_URL):
#   <PUBLIC_API_URL>/auth/social/google/callback/   (and microsoft, github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
