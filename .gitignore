# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# Environment variables (never commit real secrets)
.env

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Raw/processed geospatial data — often large; keep folder structure only.
# See docs/DATA_DICTIONARY.md for how to fetch each dataset.
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Google Drive sync staging (this repo lives in a synced folder)
.tmp.driveupload/

# Local git worktrees used for the branch-per-feature workflow (each is a
# full checkout of another branch inside this repo folder) — never committed.
.worktrees/

# Local credentials (Earth Engine token, mounted into the web container).
.secrets/

# The Cloudflare origin certificate and key, copied onto the server only.
deploy/certs/*
!deploy/certs/.gitkeep

# Working documents: plans, the report draft and session notes. Kept on the
# author's machine only. The data dictionary and the figures stay in the
# repository, because the README and riskengine/ml/README.md refer to them.
docs/*
!docs/DATA_DICTIONARY.md
!docs/DEPLOYMENT.md
# The engine's own docs, for examiners and the teams that consume the API.
!docs/ENGINE_SPEC.md
!docs/ARCHITECTURE.md
!docs/FUTURE_WORK.md
!docs/figures/

# Written by scripts/windows/start-scheduler.ps1
scheduler-task.log
