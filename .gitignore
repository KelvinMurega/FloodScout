# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# Environment variables (never commit real secrets)
.env

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Raw/processed geospatial data — often large; keep folder structure only.
# See docs/ for how to fetch each dataset (matches Sprint 1 data acquisition plan).
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Google Drive sync staging (this repo lives in a synced folder)
.tmp.driveupload/

# Local git worktrees used for the branch-per-feature workflow
.worktrees/
